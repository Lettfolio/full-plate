    "audit:large": "FP_AUDIT_TEXT=large node scripts/type-audit.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@full-plate/content": "workspace:*",
    "@full-plate/handson": "workspace:*",
    "@full-plate/sim-career": "workspace:*",
    "@full-plate/sim-core": "workspace:*",
    "@full-plate/sim-empire": "workspace:*",
    "@full-plate/sim-stars": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^31.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
