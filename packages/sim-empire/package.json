{
  "name": "@full-plate/sim-empire",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p demo/tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build --config demo/vite.config.ts",
    "demo": "vite --config demo/vite.config.ts --host",
    "headless": "tsx src/headless.ts"
  },
  "dependencies": {
    "@full-plate/sim-core": "workspace:*"
  },
  "devDependencies": {
    "@full-plate/content": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
